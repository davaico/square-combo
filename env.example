# Square Configuration
SQUARE_BASE_URL=https://connect.squareup.com
SQUARE_CLIENT_ID=your_square_client_id
SQUARE_CLIENT_SECRET=your_square_client_secret
SQUARE_ENVIRONMENT=production

# Combo API Configuration
COMBO_API_KEY=your_combo_api_key
COMBO_BASE_URL=https://partner.combohr.com

# Database Configuration
DATABASE_URL=sqlite:///./square_combo.db

# Application Configuration
LOG_LEVEL=DEBUG
SYNC_TIME=00:00  # Time to run daily sync (HH:MM format)
SYNC_DAYS_BACK=1  # Number of days back to fetch revenue data

# Server Configuration
HOST=0.0.0.0
PORT=8000



# OAuth credentials: register APP_URL/square-auth/callback in the Square dashboard.
SQUARE_CLIENT_ID=your_square_application_id
SQUARE_CLIENT_SECRET=your_square_application_secret
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-09-16
APP_URL=http://localhost:8000
COMBO_BASE_URL=https://partner.combohr.com

# Local defaults use absolute repository-root paths; omit these to keep them.
# Production example (all paths writable only by the runtime account):
# DATABASE_URL=sqlite:////srv/square-combo/shared/square_combo.db
# LOG_DIR=/srv/square-combo/shared/logs
# SYNC_LOCK_PATH=/srv/square-combo/shared/sync.lock
HOST=127.0.0.1
PORT=8000
BUSINESS_TIMEZONE=Europe/Paris
BUSINESS_DAY_START_HOUR=6
REVENUE_CURRENCY=EUR
SYNC_DAYS_BACK=1
SYNC_LOOKBACK_DAYS=3
ALLOW_SINGLE_LOCATION_MAPPING=false
HTTP_TIMEOUT_SECONDS=15
HTTP_RETRIES=2
MAX_API_PAGES=1000
LOG_LEVEL=INFO
SETUP_TTL_SECONDS=600
